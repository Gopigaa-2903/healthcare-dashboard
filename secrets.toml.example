# Copy this file to  .streamlit/secrets.toml  and fill it in.
# Gmail: turn on 2-Step Verification, then create an "App password" (Google Account → Security → App passwords).
[smtp]
host = "smtp.gmail.com"
port = 587                      # 587 = STARTTLS, 465 = SSL
user = "yourname@gmail.com"
password = "xxxx xxxx xxxx xxxx"   # the 16-char App password, NOT your normal password
sender = "yourname@gmail.com"

# Testing only: if SMTP is not set up, show the reset code on screen instead of emailing it.
# dev_show_code = true
